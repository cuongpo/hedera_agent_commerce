# Funded Hedera testnet operator. Never commit your filled .env file.
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_RPC_URL=https://testnet.hashio.io/api
HEDERA_MIRROR_URL=https://testnet.mirrornode.hedera.com/api/v1
AGENT_INITIAL_HBAR=5

# Optional: override the demo's 0.1 HBAR max per order and 1 HBAR total cap.
DEMO_MAX_PER_ORDER_HBAR=0.1
DEMO_TOTAL_BUDGET_HBAR=1
